PAYMENT_SUCCESS_URL=https://ie.siteformo.com/payment-success/
PREVIEW_BASE_URL=https://preview.siteformo.com
REVIEW_BASE_URL=https://siteformo.com/review

# Database
DATABASE_URL=
POSTGRES_URL=
POSTGRESQL_URL=
SUPABASE_DB_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email / Resend
RESEND_API_KEY=
EMAIL_FROM=SiteFormo <hello@siteformo.com>
OWNER_EMAIL=klon97048@gmail.com

# Security
APP_SECRET_KEY=change-this
APPROVAL_SECRET=change-this
ASSET_SIGNING_SECRET=change-this
REVIEW_SIGNING_SECRET=change-this
ADMIN_API_KEY=
TURNSTILE_SECRET_KEY=

# OpenAI / production assistance
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1-mini

# Storage / preview delivery
STORAGE_BACKEND=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=siteformo-previews
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=

# Queue
QUEUE_BACKEND=inline
REDIS_URL=
QUEUE_POLL_SECONDS=5

# SiteFormo business logic
STARTER_REVISION_ROUNDS=1
DEFAULT_REVISION_ROUNDS=2
PROTECTED_REVIEW_ENABLED=true
FINAL_ZIP_AFTER_APPROVAL_ONLY=true
EXAMPLE_TRACKING_ENABLED=true
INTERACTION_STYLE_ENABLED=true
STARTER_SKIPS_INTERACTION_STYLE=true

# Optional notification channels
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=
WHATSAPP_PROVIDER=twilio
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
