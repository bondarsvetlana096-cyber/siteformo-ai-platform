# SiteFormo production environment
# Copy these variables into Railway. Do not commit real secrets.

APP_ENV=production
LOG_LEVEL=info
DEBUG=false

# Public URLs
PUBLIC_BASE_URL=https://siteformo-ai-platform-production.up.railway.app
BACKEND_URL=https://siteformo-ai-platform-production.up.railway.app
APP_BASE_URL=https://ie.siteformo.com
WORDPRESS_URL=https://siteformo.com
MAIN_SITE_BASE_URL=https://siteformo.com
QUESTIONNAIRE_URL=https://ie.siteformo.com/extended-questionnaire/
